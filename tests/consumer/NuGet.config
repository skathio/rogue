<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Every run packs the same version, so the machine-wide package cache would serve the copy
         of an earlier run. run.sh empties this folder first. -->
    <add key="globalPackagesFolder" value="../../artifacts/consumer/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="rogue-local" value="../../artifacts/consumer/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- SkathIO.Rogue packages come from the local feed only, never from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="rogue-local">
      <package pattern="SkathIO.Rogue" />
      <package pattern="SkathIO.Rogue.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
