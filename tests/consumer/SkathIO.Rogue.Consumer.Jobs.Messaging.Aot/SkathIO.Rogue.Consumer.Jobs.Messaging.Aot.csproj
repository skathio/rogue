<Project Sdk="Microsoft.NET.Sdk">
  <!-- samples/SkathIO.Rogue.Jobs.Messaging.Aot.Sample built as an app would build it: the same
       Program.cs, with the packages restored from the local feed instead of project references. The
       core generator and the jobs analyzer come from the packages' analyzers/ folders. aot.sh
       publishes it natively and runs it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <AssemblyName>SkathIO.Rogue.Jobs.Messaging.Aot.Sample</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../samples/SkathIO.Rogue.Jobs.Messaging.Aot.Sample/Program.cs" Link="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkathIO.Rogue" />
    <PackageReference Include="SkathIO.Rogue.Jobs" />
    <PackageReference Include="SkathIO.Rogue.Messaging" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
