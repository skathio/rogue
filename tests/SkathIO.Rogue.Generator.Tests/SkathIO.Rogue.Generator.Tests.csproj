<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SkathIO.Rogue.SourceGenerator\SkathIO.Rogue.SourceGenerator.csproj" />
    <ProjectReference Include="..\..\src\SkathIO.Rogue.Abstractions\SkathIO.Rogue.Abstractions.csproj" />
    <!--
      The runtime DLL (PipelineExecutor / RogueDispatcher / RequestExceptionHandlerState) is referenced
      so the compile-verification helper can feed the generated RogueDispatcher.g.cs through a real
      CSharpCompilation and assert it produces zero Error-severity diagnostics. The generator inside
      this project is a plain ProjectReference (not OutputItemType="Analyzer"), so it does not run over
      the test project's own source.
    -->
    <ProjectReference Include="..\..\src\SkathIO.Rogue\SkathIO.Rogue.csproj" />
    <!-- The validation package: ValidationPackageTests compile consumer code against its built DLL, so
         building this project must build it too. -->
    <ProjectReference Include="..\..\src\SkathIO.Rogue.Validation\SkathIO.Rogue.Validation.csproj" />
    <!-- The jobs package: JobsCoreTests compile consumer code against its built DLL and load its
         analyzer and code fix from their build output, so building this project must build all three. -->
    <ProjectReference Include="..\..\src\SkathIO.Rogue.Jobs\SkathIO.Rogue.Jobs.csproj" />
    <!-- The messaging package: MessagingCoreRulesTests compile consumer code against its built DLL, which
         they load from the package's own output, so this builds it without referencing its assembly. -->
    <ProjectReference Include="..\..\src\SkathIO.Rogue.Messaging\SkathIO.Rogue.Messaging.csproj"
                      ReferenceOutputAssembly="false" />
    <!-- MessagingRabbitMqRulesTests and MessagingOutboxInboxRulesTests read these packages' built DLLs
         from their own output. Without a reference, `dotnet test` on the solution can run these tests
         before those projects finish building, and the rules then find no DLL to read. -->
    <ProjectReference Include="..\..\src\SkathIO.Rogue.Messaging.RabbitMQ\SkathIO.Rogue.Messaging.RabbitMQ.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\SkathIO.Rogue.Messaging.Outbox\SkathIO.Rogue.Messaging.Outbox.csproj"
                      ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Verify.Xunit" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <!-- ServiceCollection / BuildServiceProvider for the runtime-dispatch verification helper. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
