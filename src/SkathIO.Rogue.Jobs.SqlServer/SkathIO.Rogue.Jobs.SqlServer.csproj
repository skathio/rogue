<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>SkathIO.Rogue.Jobs.SqlServer</PackageId>
    <Description>SQL Server job store for SkathIO.Rogue.Jobs: batched READPAST/UPDLOCK claims, bulk enqueue through a table-valued parameter, adaptive polling that wakes idle workers, migrations under sp_getapplock, and a pruner for finished jobs.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>cqrs;mediator;jobs;background;sqlserver;mssql;sqlclient;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SkathIO.Rogue.Jobs\SkathIO.Rogue.Jobs.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>
  <ItemGroup>
    <!-- Internals every database store shares (pruner, migration gate, claim order), compiled into
         each store package from one source so the stores cannot drift apart. -->
    <Compile Include="..\SkathIO.Rogue.Jobs\StoreShared\*.cs" LinkBase="StoreShared" />
  </ItemGroup>
</Project>
