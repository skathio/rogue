<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>SkathIO.Rogue.Messaging</PackageId>
    <Description>Message bus for SkathIO.Rogue: events and commands travel between services under stable names, are dispatched to Rogue handlers through source-generated code (no reflection), and are retried and dead-lettered by a consumer host over a pluggable transport.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>cqrs;mediator;messaging;message-bus;source-generator;aot</PackageTags>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The name-to-dispatch map is emitted by the core source generator, which this package brings in
         through its SkathIO.Rogue dependency. -->
    <ProjectReference Include="..\SkathIO.Rogue\SkathIO.Rogue.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
